{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  },
  "pnpm": {
    "overrides": {
      "node-forge": ">=1.4.0",
      "path-to-regexp": ">=8.4.0",
      "picomatch": ">=4.0.4",
      "@xmldom/xmldom": ">=0.9.10",
      "lodash": "4.18.0",
      "axios": "1.16.1",
      "cookie": "0.7.2",
      "follow-redirects": "1.16.0",
      "shell-quote": ">=1.8.4",
      "elliptic": "6.6.1",
      "@stablelib/ed25519": "2.1.0",
      "protobufjs": ">=7.6.4 <8.0.0",
      "ip-address": ">=10.2.0",
      "postcss": ">=8.5.10",
      "uuid": ">=14.0.0",
      "nodemailer": ">=9.0.1",
      "tmp": ">=0.2.6",
      "ws": ">=8.20.1",
      "qs": ">=6.15.2",
      "fast-uri": ">=3.1.2",
      "esbuild": "0.28.1",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "serialize-javascript": ">=7.0.3",
      "undici": ">=6.27.0 <8.0.0",
      "form-data": ">=4.0.6 <5.0.0",
      "markdown-it": ">=14.2.0 <15.0.0",
      "dompurify": ">=3.4.11 <4.0.0",
      "ua-parser-js": ">=2.0.10 <3.0.0",
      "js-yaml": ">=4.2.0 <5.0.0",
      "@babel/core": ">=7.29.6 <8.0.0"
    },
    "auditConfig": {
      "ignoreCves": [
        "GHSA-848j-6mx2-7j84"
      ]
    }
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "stripe": "^22.1.0",
    "stripe-replit-sync": "^1.0.0"
  }
}
