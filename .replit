modules = ["nodejs-20", "web", "python-3.12", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/bsv-dex"

[deployment]
router = "application"
deploymentTarget = "vm"
run = ["node", "start.mjs"]
build = ["bash", "-c", "pnpm install --frozen-lockfile --prefer-offline && pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/bsv-dex run build"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[[ports]]
localPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 20180

[workflows]

[[workflows.workflow]]
name = "artifacts/bsv-dex: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/bsv-dex"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node serve-static.mjs"
cwd = "./artifacts/bsv-dex"
waitForPort = 20180
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "20180"
BASE_PATH = "/"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8080"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["github:1.0.0", "javascript_openai_ai_integrations:2.0.0", "javascript_anthropic_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
VAULT_CONTRACT_ADDRESS = "0x67C7f23eE49B6417661748F23F743C0B274039e2"
VAULT_CHAIN_ID = "8453"
VITE_REOWN_PROJECT_ID = "04663615251cf13fb1b043d754e7a17f"
