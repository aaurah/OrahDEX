run = "pnpm --filter mockup-sandbox dev"
modules = ["nodejs-20"]

[deployment]
build = "BASE_PATH=/ PORT=3000 pnpm --filter mockup-sandbox build"
run = ""
deploymentTarget = "static"
staticPublishPath = "artifacts/mockup-sandbox/dist"

[[ports]]
localPort = 3000
externalPort = 80

[nix]
packages = ["zip"]

[agent]
expertMode = true
