modules = ["nodejs-24", "postgresql-16", "python-3.11"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/bsv-dex"

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["sh", "-c", "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/bsv-dex run build"]
run = ["sh", "-c", "pnpm --filter @workspace/api-server run start & PORT=20180 pnpm --filter @workspace/bsv-dex run start"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "test -f artifacts/bsv-dex/dist/public/index.html || pnpm --filter @workspace/bsv-dex run build && PORT=20180 pnpm --filter @workspace/bsv-dex run dev"
waitForPort = 20180

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
VAULT_CONTRACT_ADDRESS = "0x67C7f23eE49B6417661748F23F743C0B274039e2"
VAULT_CHAIN_ID = "8453"
VITE_REOWN_PROJECT_ID = "04663615251cf13fb1b043d754e7a17f"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 20180
externalPort = 80
