# Required
EVM_WALLET_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
SIMPLESWAP_API_KEY=
LETSEXCHANGE_API_KEY=
COINBASE_API_KEY=
COINBASE_SECRET=
COINBASE_PROJECT_ID=
DATABASE_URL=

# Optional RPC
ETH_RPC_URL=
ETH_WS_URL=
SEPOLIA_RPC_URL=
BASE_RPC_URL=
ARB_RPC_URL=
OP_RPC_URL=
BSC_RPC_URL=
POLYGON_RPC_URL=
AVAX_RPC_URL=
ZKSYNC_RPC_URL=

# Optional contracts / wallets
EVM_RELAYER_KEY=
EXCHANGE_HOT_WALLET_KEY=

# Webhooks
EVM_WEBHOOK_SECRET=
EVM_WATCHED_CONTRACTS=
STRIPE_WEBHOOK_SECRET=
EMAIL_INBOUND_WEBHOOK_SECRET=
API_KEY_HMAC_SECRET=

# AI — local Ollama (optional; works without a hosted AI key)
# Pull the tag first (`ollama pull llama3.2:3b`), then set it here. DEVAI_MODEL
# is used by DevAI, ORA_AI_MODEL by Orah AI (falls back to DEVAI_MODEL).
DEVAI_OLLAMA_ENABLED=false
DEVAI_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
DEVAI_OLLAMA_REMOTE=false
DEVAI_MODEL=qwen2.5-coder:1.5b
ORA_AI_MODEL=llama3.2:3b
# For remote Ollama only: Cloudflare Access Service Auth credentials.
# Store real values as Replit Secrets; never commit them or paste them in chat.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# DevAI GitHub access (optional). Read works anonymously for public repos;
# write needs a token with Contents + Pull requests write, which DevAI uses to
# open draft pull requests (never pushes to the base branch).
GITHUB_TOKEN=
DEVAI_GITHUB_TOKEN=

# Feature flags
FUTURES_ENABLED=false
NFT_ENABLED=false

# Local ports
PORT=8080
FRONTEND_PORT=20180
