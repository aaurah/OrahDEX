# ── Required ──────────────────────────────────────────────────────────────────
# Master secret used to derive AES-256-GCM keys for all custodial EVM wallets.
# FATAL on startup if missing. Rotate carefully — all encrypted wallets must be
# re-encrypted when this value changes.
EVM_WALLET_SECRET=

DATABASE_URL=

# Admin panel credentials (all three required for full MFA)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=

# ── Payment integrations ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Exchange integrations ──────────────────────────────────────────────────────
SIMPLESWAP_API_KEY=
LETSEXCHANGE_API_KEY=
COINBASE_API_KEY=
COINBASE_SECRET=
COINBASE_PROJECT_ID=

# ── ThirdWeb bridge ────────────────────────────────────────────────────────────
THIRDWEB_SECRET_KEY=
VITE_THIRDWEB_CLIENT_ID=

# ── NFT / Zora ─────────────────────────────────────────────────────────────────
VITE_ZORA_API_KEY=

# ── EVM chain RPC endpoints ────────────────────────────────────────────────────
ETH_RPC_URL=
ETH_WS_URL=
SEPOLIA_RPC_URL=
BASE_RPC_URL=
ARB_RPC_URL=
OP_RPC_URL=
BSC_RPC_URL=
POLYGON_RPC_URL=
AVAX_RPC_URL=
ZKSYNC_RPC_URL=

# ── Optional contracts / wallets ───────────────────────────────────────────────
EVM_RELAYER_KEY=
EXCHANGE_HOT_WALLET_KEY=

# ── Webhooks ───────────────────────────────────────────────────────────────────
# REQUIRED for EVM deposit monitoring — server rejects all webhook payloads
# if this is unset (fails closed).
EVM_WEBHOOK_SECRET=
EVM_WATCHED_CONTRACTS=

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Set this for production deployments.
# Example: ALLOWED_ORIGINS=https://orahdex.org,https://www.orahdex.org
ALLOWED_ORIGINS=

# ── Feature flags ──────────────────────────────────────────────────────────────
FUTURES_ENABLED=false
NFT_ENABLED=false

# ── Performance tuning ─────────────────────────────────────────────────────────
# Max DB pool connections. Default 20. Neon free tier: keep at 10-15.
DB_POOL_MAX=20

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Local ports ────────────────────────────────────────────────────────────────
PORT=8080
FRONTEND_PORT=20180
