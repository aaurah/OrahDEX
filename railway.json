{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter \"@workspace/api-server...\" --filter \"@workspace/bsv-dex...\" run build"
  },
  "deploy": {
    "startCommand": "node --enable-source-maps --max-old-space-size=4096 artifacts/api-server/dist/index.mjs",
    "healthcheckPath": "/api/healthz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
