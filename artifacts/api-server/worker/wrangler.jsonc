{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orahdex-api",
  "main": "./dist/index.js",
  // dist/index.js is already a fully bundled worker script (built by
  // worker/build.mjs with workerd-specific shims). Wrangler must NOT re-bundle
  // it — a second esbuild pass breaks the CJS interop patches.
  "no_bundle": true,
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Paid (standard) account — raise the per-request CPU budget so a cold
  // WebSocket handshake + heavy first query can't trip error 1102 at 10s.
  "limits": { "cpu_ms": 30000 },
  "d1_databases": [
    { "binding": "ORAHDEX_DB", "database_name": "orahdex-db", "database_id": "d751fe1d-70f7-4761-8c3a-0a73c93c010a" }
  ],
  "kv_namespaces": [
    { "binding": "ORAHDEX_KV", "id": "8dd2e276f6944b1aa06548efb4294d06" }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://aaurah.org,https://www.aaurah.org,https://orahdex.com,https://www.orahdex.com,https://orahdex.site,https://www.orahdex.site,https://orahdex.org,https://www.orahdex.org"
  }
}
