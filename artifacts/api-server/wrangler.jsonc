{
  "name": "orahdex-api",
  "main": "dist/app.mjs",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "ORAHDEX_KV",
      "id": "8dd2e276f6944b1aa06548efb4294d06"
    }
  ],
  "d1_databases": [
    {
      "binding": "ORAHDEX_DB",
      "database_name": "orahdex",
      "database_id": "PASTE_YOUR_ACTUAL_D1_DATABASE_ID_HERE"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
