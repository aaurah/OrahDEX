cat > ~/OrahDEX/artifacts/api-server/wrangler.jsonc << 'EOF'
{
  "name": "orahdex-api",
  "main": "dist/app.mjs",
  "compatibility_date": "2026-08-26",
  "d1_databases": [
    {
      "binding": "ORAHDEX_DB",
      "database_name": "orahdex",
      "database_id": "d751fe1d-70f7-4761-8c3a-0a73c93c010a"
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
EOF
