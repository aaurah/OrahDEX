{
  "$schema": "https://schema.railway.app/railway.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install -g pnpm@9 && pnpm install --frozen-lockfile && node ./build.mjs"
  },
  "deploy": {
    "startCommand": "node --max-old-space-size=512 --enable-source-maps ./dist/index.mjs",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
