{
{
  "name": "orahdex",
  "main": "./worker.js",
  "routes": [
    { "pattern": "orahdex.com", "custom_domain": true },
    { "pattern": "orahdex.org", "custom_domain": true },
    { "pattern": "tradeora.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "compatibility_date": "2026-07-30"
}

