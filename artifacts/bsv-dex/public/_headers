# Hashed Vite bundles never change content — cache them for a year so repeat
# visits skip the ~1.9 MB of JS revalidation round-trips.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.json
  Cache-Control: public, max-age=3600

/*.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400
